/* ---------- GET CART ---------- */

function getCart() {

    return JSON.parse(
        localStorage.getItem('ayushCart')
    ) || [];

}


/* ---------- SAVE CART ---------- */

function saveCart(cart) {

    localStorage.setItem(
        'ayushCart',
        JSON.stringify(cart)
    );

}


/* ---------- UPDATE TOP CART NUMBER ---------- */

function updateCartNumber() {

    var cart = getCart();

    var totalQuantity = 0;

    cart.forEach(function(item) {

        totalQuantity += Number(item.quantity);

    });

    $('.js-show-cart').attr(
        'data-notify',
        totalQuantity
    );

}


/* ---------- UPDATE CART SIDEBAR ---------- */

function updateCartSidebar() {

    var cart = getCart();

    var list = $('.header-cart-wrapitem');

    var total = 0;

    list.empty();


    if (cart.length === 0) {

        list.html(
            '<li style="padding:30px;text-align:center;">' +
            'Your cart is empty' +
            '</li>'
        );

        $('.header-cart-total').text(
            'Total: ₹0.00'
        );

        updateCartNumber();

        return;
    }


    cart.forEach(function(item, index) {

        var itemTotal =
            Number(item.price) *
            Number(item.quantity);

        total += itemTotal;


        list.append(

            '<li class="header-cart-item flex-w flex-t m-b-12">' +

                '<div class="header-cart-item-img">' +

                    '<img src="' +
                    item.image +
                    '" alt="IMG">' +

                '</div>' +


                '<div class="header-cart-item-txt p-t-8">' +

                    '<a href="#" ' +
                    'class="header-cart-item-name m-b-18 hov-cl1 trans-04">' +

                        item.name +

                    '</a>' +


                    '<span class="header-cart-item-info">' +

                        '₹' +
                        Number(item.price).toFixed(2) +

                    '</span>' +


                    '<div style="margin-top:10px;">' +

                        '<button type="button" ' +
                        'class="cart-minus" ' +
                        'data-index="' + index + '">' +

                            '−' +

                        '</button>' +


                        '<span style="padding:0 12px;">' +

                            item.quantity +

                        '</span>' +


                        '<button type="button" ' +
                        'class="cart-plus" ' +
                        'data-index="' + index + '">' +

                            '+' +

                        '</button>' +

                    '</div>' +

                '</div>' +

            '</li>'

        );

    });


    $('.header-cart-total').text(
        'Total: ₹' + total.toFixed(2)
    );


    updateCartNumber();

}


/* =====================================
   QUICK VIEW OPEN
   LOAD EXISTING CART QUANTITY
===================================== */

$(document).on(
    'click',
    '.js-show-modal1',
    function() {

        var productCard =
            $(this).closest('.block2');


        var productName =
            productCard
            .find('.js-name-b2')
            .text()
            .trim();


        var productPrice =
            productCard
            .find('.stext-105')
            .text()
            .trim();


        /* Product name */

        $('.js-modal1 .js-name-detail')
            .text(productName);


        /* Product price */

        $('.js-modal1 .mtext-106')
            .text(productPrice);


        /* ---------- FIND CART ---------- */

        var cart = getCart();

        var currentQuantity = 0;


        cart.forEach(function(item) {

            if (
                item.name === productName
            ) {

                currentQuantity =
                    Number(item.quantity);

            }

        });


        /* ---------- SHOW QUANTITY ---------- */

        $('.js-modal1 .num-product')
            .val(currentQuantity);

    }
);


/* =====================================
   QUICK VIEW +
===================================== */

$(document).on(
    'click',
    '.js-modal1 .btn-num-product-up',
    function() {

        var input =
            $('.js-modal1 .num-product');

        var quantity =
            parseInt(input.val()) || 0;

        quantity++;

        input.val(quantity);

    }
);


/* =====================================
   QUICK VIEW -
===================================== */

$(document).on(
    'click',
    '.js-modal1 .btn-num-product-down',
    function() {

        var input =
            $('.js-modal1 .num-product');

        var quantity =
            parseInt(input.val()) || 0;


        if (quantity > 0) {

            quantity--;

        }


        input.val(quantity);

    }
);


/* =====================================
   ADD TO CART
===================================== */

$(document).on(
    'click',
    '.js-addcart-detail',
    function(e) {

        e.preventDefault();


        /* Product name */

        var name =
            $('.js-modal1 .js-name-detail')
            .text()
            .trim();


        /* Product price */

        var priceText =
            $('.js-modal1 .mtext-106')
            .text()
            .trim();


        var price =
            parseFloat(
                priceText.replace(
                    /[^\d.]/g,
                    ''
                )
            );


        /* Quantity selected */

        var quantity =
            parseInt(
                $('.js-modal1 .num-product').val()
            ) || 0;


        /* Product image */

        var image =
            $('.js-modal1 .item-slick3')
            .eq(0)
            .find('img')
            .attr('src');


        /* ---------- VALIDATION ---------- */

        if (!name || isNaN(price)) {

            alert(
                'Product information not found!'
            );

            return;

        }


        if (quantity <= 0) {

            alert(
                'Please select at least 1 quantity.'
            );

            return;

        }


        /* ---------- GET CART ---------- */

        var cart = getCart();

        var found = false;


        /* ---------- UPDATE EXISTING PRODUCT ---------- */

        cart.forEach(function(item) {

            if (
                item.name === name
            ) {

                item.quantity =
                    quantity;

                found = true;

            }

        });


        /* ---------- NEW PRODUCT ---------- */

        if (!found) {

            cart.push({

                name: name,

                price: price,

                image: image,

                quantity: quantity

            });

        }


        /* ---------- SAVE ---------- */

        saveCart(cart);


        /* ---------- UPDATE EVERYTHING ---------- */

        updateCartNumber();

        updateCartSidebar();


        /* ---------- SUCCESS ---------- */

        swal(
            name,
            "cart updated successfully!",
            "success"
        );

    }
);


/* =====================================
   CART SIDEBAR +
===================================== */

$(document).on(
    'click',
    '.cart-plus',
    function() {

        var index =
            $(this).data('index');

        var cart = getCart();


        cart[index].quantity++;


        saveCart(cart);

        updateCartNumber();

        updateCartSidebar();

    }
);


/* =====================================
   CART SIDEBAR -
===================================== */

$(document).on(
    'click',
    '.cart-minus',
    function() {

        var index =
            $(this).data('index');

        var cart = getCart();


        cart[index].quantity--;


        if (
            cart[index].quantity <= 0
        ) {

            cart.splice(index, 1);

        }


        saveCart(cart);

        updateCartNumber();

        updateCartSidebar();

    }
);


/* =====================================
   PAGE LOAD
===================================== */

$(document).ready(function() {

    updateCartNumber();

    updateCartSidebar();

});
	
	</script>
